@startuml design-1-camadas
!include estilo.iuml
title GastoCerto — Design (vista 1): camadas e dependências
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #2D3142
  FontColor #2D3142
  FontSize 11
  StereotypeFontColor #5A6580
}
skinparam rectangle<<dominio>> {
  BackgroundColor #F9ECE7
  BorderColor #BF4520
}
skinparam rectangle<<grupo>> {
  BackgroundColor #F5F5F5
  BorderColor #BFC0C0
  FontColor #4F5D75
}
hide <<dominio>> stereotype
hide <<grupo>> stereotype

rectangle "<b>androidApp · iosApp · webApp</b>\npontos de entrada (MainActivity, MainViewController, main)" as plat

rectangle "módulo shared · commonMain" as common <<grupo>> {
  rectangle "<b>ui</b>\nScreens Compose · ViewModels\nXUiState · XEvent" as ui
  rectangle "<b>usecase</b>\num *UseCase por caso de uso\n(papel GRASP Controller)" as uc
  rectangle "domain" as dom <<dominio>> {
    rectangle "<b>model</b>\nentidades e valores" as model
    rectangle "<b>rule</b>\nStrategy · Factory · exceções" as regra
    rectangle "<b>repository</b>\ninterfaces + Transaction" as repo
  }
  rectangle "<b>data.memory</b>\nrepositórios em memória\n(Web e testes)" as mem
  rectangle "<b>di</b>\nmódulos Koin" as di
}
rectangle "módulo shared · mobileMain (Android + iOS)" as mobile <<grupo>> {
  rectangle "<b>data</b> (Room KMP)\nentities · DAOs · mappers\nRoom*Repository · RoomTransaction" as room
}

plat -down-> ui
ui -down-> uc
uc -down-> regra
uc -down-> repo
uc -down-> model
regra -right-> model
repo -left-> model
mem -up-> repo : implementa
room -up-> repo : implementa
di .left.> ui : monta
di .left.> uc
di .down.> mem
di .down.> room

legend right
  Setas = "depende de". <b>domain</b> (destaque) não depende
  de nenhuma outra camada nem de framework [RNF07].
  Persistência substituível: Room no Android/iOS,
  memória na Web e nos testes, sem mudar domain/usecase.
endlegend
@enduml
