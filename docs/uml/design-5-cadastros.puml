@startuml design-5-cadastros
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
title GastoCerto — Design (vista 5): cadastros e demais casos de uso
left to right direction

package "ui" {
  class RegistryViewModel {
    + uiState : StateFlow<RegistryUiState>
    + events : Flow<RegistryEvent>
    + addPerson()
    + addInstitution()
    + addPaymentMethod()
    + deactivate(paymentMethod : PaymentMethod)
    + delete(paymentMethod : PaymentMethod)
  }
  class RecurrencesViewModel {
    + uiState : StateFlow<RecurrencesUiState>
    + events : Flow<RecurrencesEvent>
    + addBill()
    + addIncome()
    + deactivateBill(bill : RecurringBill)
    + deactivateIncome(income : RecurringIncome)
  }
  class InvestmentsViewModel {
    + setPlannedContribution(account : InvestmentAccount, amount : Long?)
    + registerSale(account : InvestmentAccount, amount : Long?)
  }
  class EntriesViewModel {
    + load(month : MonthYear)
    + registerIncome()
    + edit(entry : Entry, amount : Long?, description : String)
    + confirmExpected(entry : Entry, actualAmount : Long?)
    + delete(entry : Entry)
  }
  class ReimbursementViewModel {
    + register()
  }
}
package "usecase" {
  class ManageRegistryUseCase <<Controller>> {
    + people() : List<Person>
    + institutions() : List<Institution>
    + activePaymentMethods() : List<PaymentMethod>
    + savePerson(person : Person)
    + saveInstitution(institution : Institution)
    + savePaymentMethod(paymentMethod : PaymentMethod)
    + deactivatePaymentMethod(paymentMethod : PaymentMethod)
    + deletePaymentMethod(paymentMethod : PaymentMethod)
  }
  class ManageRecurrencesUseCase <<Controller>> {
    + recurringBills() : List<RecurringBill>
    + recurringIncomes() : List<RecurringIncome>
    + saveRecurringBill(bill : RecurringBill)
    + saveRecurringIncome(income : RecurringIncome)
  }
  class ManageInvestmentsUseCase <<Controller>> {
    + setPlannedContribution(account : InvestmentAccount, amount : Money?) : InvestmentAccount
    + registerSale(account : InvestmentAccount, amount : Money, date : LocalDate) : Income
  }
  class RegisterOneOffIncomeUseCase <<Controller>> {
    + execute(amount : Money, date : LocalDate, description : String) : Income
  }
  class CorrectEntryUseCase <<Controller>> {
    + entriesOf(month : MonthYear) : List<Entry>
    + edit(entry : Entry)
    + delete(entry : Entry)
    + confirmExpected(entry : Entry, actualAmount : Money) : Entry
  }
  class RegisterReimbursementUseCase <<Controller>> {
    + receivableBalance(thirdParty : Person) : ReceivableBalance
    + execute(thirdParty : Person, amount : Money, date : LocalDate) : Reimbursement
  }
  class SeedDemoDataUseCase {
    + execute(labels : DemoLabels) : Boolean
  }
}
package "domain (vistas 3 e 4b)" {
  class RegistryRepository <<ref>>
  class RecurrenceRepository <<ref>>
  class EntryRepository <<ref>>
  class AccountingMonthRepository <<ref>>
  class ReimbursementRepository <<ref>>
  class EntryFactory <<ref>>
}
class CloseMonthUseCase <<ref>>

RegistryViewModel --> ManageRegistryUseCase
RecurrencesViewModel --> ManageRecurrencesUseCase
RecurrencesViewModel --> ManageRegistryUseCase : meios
InvestmentsViewModel --> ManageInvestmentsUseCase
EntriesViewModel --> RegisterOneOffIncomeUseCase
EntriesViewModel --> CorrectEntryUseCase
ReimbursementViewModel --> RegisterReimbursementUseCase
InvestmentsViewModel --> ManageRegistryUseCase : corretoras
ManageRegistryUseCase --> RegistryRepository
ManageRecurrencesUseCase --> RecurrenceRepository
ManageRecurrencesUseCase --> EntryFactory
ManageRecurrencesUseCase --> EntryRepository
ManageInvestmentsUseCase --> RegistryRepository
ManageInvestmentsUseCase --> EntryRepository
ManageInvestmentsUseCase --> EntryFactory
ManageInvestmentsUseCase --> AccountingMonthRepository
ManageRecurrencesUseCase --> AccountingMonthRepository
RegisterOneOffIncomeUseCase --> EntryFactory
RegisterOneOffIncomeUseCase --> EntryRepository
RegisterOneOffIncomeUseCase --> AccountingMonthRepository
CorrectEntryUseCase --> EntryRepository
CorrectEntryUseCase --> AccountingMonthRepository
RegisterReimbursementUseCase --> EntryRepository
RegisterReimbursementUseCase --> ReimbursementRepository
SeedDemoDataUseCase ..> ManageRegistryUseCase : usa
SeedDemoDataUseCase ..> ManageRecurrencesUseCase : usa
SeedDemoDataUseCase ..> RegisterReimbursementUseCase : usa
SeedDemoDataUseCase ..> CloseMonthUseCase : fecha o mês anterior

legend right
  ManageRecurrencesUseCase usa a Factory para gerar o
  previsto do mês aberto ao cadastrar uma conta fixa [RN06].
  ManageRegistryUseCase só exclui meio sem lançamentos;
  com lançamentos, só desativa [RN09]. CorrectEntryUseCase
  respeita mês fechado [RN08]. Reembolso ≤ saldo [RN03].
  Todo XViewModel expõe uiState (StateFlow) e events (Flow) e
  atualiza o estado antes de emitir o evento.
  SeedDemoDataUseCase carrega a demo na 1ª execução só pelos
  use cases (também registra gastos e compras parceladas e
  fecha o mês anterior, gerando os previstos do mês atual);
  é idempotente: não faz nada se já houver pessoas.
endlegend
@enduml
