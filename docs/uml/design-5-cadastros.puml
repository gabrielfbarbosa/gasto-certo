@startuml design-5-cadastros
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
title GastoCerto — Design (vista 5): cadastros e demais casos de uso
left to right direction

package "ui" {
  class CadastrosViewModel
  class RecorrenciasViewModel
  class InvestimentosViewModel
  class LancamentosViewModel
}
package "usecase" {
  class GerenciarCadastrosUseCase <<Controller>> {
    + salvarPessoa(p : Pessoa)
    + salvarInstituicao(i : Instituicao)
    + salvarMeio(m : MeioDePagamento)
    + desativarMeio(m : MeioDePagamento)
  }
  class GerenciarRecorrenciasUseCase <<Controller>> {
    + salvarContaFixa(c : ContaFixa)
    + salvarReceitaRecorrente(r : ReceitaRecorrente)
  }
  class GerenciarInvestimentosUseCase <<Controller>> {
    + definirAportePlanejado(c : ContaInvestimento, v : Dinheiro)
    + registrarVenda(c : ContaInvestimento, v : Dinheiro, data : LocalDate)
  }
  class RegistrarReceitaAvulsaUseCase <<Controller>> {
    + executar(valor : Dinheiro, data : LocalDate, descricao : String)
  }
  class CorrigirLancamentoUseCase <<Controller>> {
    + editar(l : Lancamento)
    + excluir(l : Lancamento)
    + confirmarPrevisto(l : Lancamento, valorReal : Dinheiro)
  }
  class RegistrarReembolsoUseCase <<Controller>> {
    + saldoAReceber(terceiro : Pessoa) : SaldoAReceber
    + executar(terceiro : Pessoa, valor : Dinheiro, data : LocalDate)
  }
}
package "domain (vistas 3 e 4b)" {
  class CadastroRepository <<ref>>
  class RecorrenciaRepository <<ref>>
  class LancamentoRepository <<ref>>
  class CompetenciaRepository <<ref>>
  class ReembolsoRepository <<ref>>
  class FabricaDeLancamentos <<ref>>
}

CadastrosViewModel --> GerenciarCadastrosUseCase
RecorrenciasViewModel --> GerenciarRecorrenciasUseCase
InvestimentosViewModel --> GerenciarInvestimentosUseCase
LancamentosViewModel --> RegistrarReceitaAvulsaUseCase
LancamentosViewModel --> CorrigirLancamentoUseCase
LancamentosViewModel --> RegistrarReembolsoUseCase
GerenciarCadastrosUseCase --> CadastroRepository
GerenciarRecorrenciasUseCase --> RecorrenciaRepository
GerenciarRecorrenciasUseCase --> FabricaDeLancamentos
GerenciarRecorrenciasUseCase --> LancamentoRepository
GerenciarInvestimentosUseCase --> CadastroRepository
GerenciarInvestimentosUseCase --> LancamentoRepository
RegistrarReceitaAvulsaUseCase --> LancamentoRepository
RegistrarReceitaAvulsaUseCase --> CompetenciaRepository
CorrigirLancamentoUseCase --> LancamentoRepository
CorrigirLancamentoUseCase --> CompetenciaRepository
RegistrarReembolsoUseCase --> LancamentoRepository
RegistrarReembolsoUseCase --> ReembolsoRepository

legend right
  GerenciarRecorrenciasUseCase usa a Factory para gerar o
  previsto do mês aberto ao cadastrar uma conta fixa [RN06].
  GerenciarCadastrosUseCase desativa, mas não exclui,
  meio com lançamentos [RN09]. CorrigirLancamentoUseCase
  respeita mês fechado [RN08]. Reembolso ≤ saldo [RN03].
endlegend
@enduml
