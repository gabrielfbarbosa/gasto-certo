@startuml sequencia-uc03
title UC03 – Fechar o mês e abrir o seguinte (diagrama de sequência)
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam BoxPadding 8
autonumber

actor "Usuário" as U
box "ui" #F7F7F5
  boundary "FecharMesScreen" as Tela
  participant "FecharMesViewModel" as VM
end box
box "application" #EEF4FB
  control "ConsultarResumo" as CR
  control "FecharMes" as UC
end box
box "domain" #FFF8EC
  participant "ResumoDoPeriodo" as Res
  participant "atual :\nCompetencia" as Atual
  participant "FabricaDeLancamentos" as Fab
  participant "ContaFixa" as CF
  participant "ReceitaRecorrente" as RR
  participant "ContaInvestimento" as CI
end box
box "domain.repositorio" #FFF8EC
  participant "Transacao" as Tx
  participant "CompetenciaRepository" as CRepo
  participant "RecorrenciaRepository" as RRepo
  participant "LancamentoRepository" as LRepo
end box

== Resumo antes de fechar ==
U -> Tela : abre "Fechar mês"
Tela -> VM : carregar(mes)
VM -> CR : doMes(mes, titular = null)
CR -> LRepo : doMes(mes)
LRepo --> CR : lancamentos
CR -> Res : de(lancamentos, null)
Res --> CR : resumo
CR --> VM : resumo (receitas, gasto total,\nterceiros, sobra) [RN04]
VM --> Tela : estado com o resumo e os\nprevistos não conferidos
Tela --> U : mostra o resumo
opt há previstos não conferidos (A1)
  U -> Tela : ajusta valores (UC09) ou segue
end

== Fechamento ==
U -> Tela : confirma o fechamento
Tela -> VM : fechar()
VM -> UC : executar(mes)
UC -> Tx : executar { ... }
activate Tx
UC -> CRepo : buscarOuCriar(mes)
CRepo --> UC : atual
UC -> Atual : fechar()
alt já estava fechada (E1)
  Atual --> UC : <<lança>> CompetenciaFechada [RN08]
  UC --> VM : CompetenciaFechada
  VM --> Tela : "Mês já fechado. Reabrir?"
else aberta
  UC -> CRepo : salvar(atual)
  UC -> CRepo : buscarOuCriar(mes.proximo())
  CRepo --> UC : seguinte
  UC -> RRepo : contasFixasAtivas()
  UC -> RRepo : receitasAtivas()
  UC -> RRepo : investimentosComAporte()
  RRepo --> UC : contas, receitas, investimentos
  UC -> Fab : previstosDoMes(seguinte.mesAno,\ncontas, receitas, investimentos)
  activate Fab
  loop cada conta fixa ativa
    Fab -> CF : gerarPrevisto(mes)
    CF --> Fab : gasto PREVISTO no dia de vencimento\n(dia inexistente = último dia) [RN06]
  end
  loop cada receita recorrente
    Fab -> RR : gerarPrevista(mes)
    RR --> Fab : receita PREVISTA no dia de recebimento [RN07]
  end
  loop cada corretora com aporte planejado
    Fab -> CI : gerarAportePrevisto(mes)
    CI --> Fab : aporte PREVISTO [RN11]
  end
  Fab --> UC : previstos
  deactivate Fab
  UC -> LRepo : doMes(seguinte.mesAno)
  LRepo --> UC : existentes
  UC -> UC : semDuplicados(previstos, existentes) (A3)
  UC -> LRepo : salvarTodos(novos)
end
Tx --> UC : confirma tudo ou desfaz tudo
deactivate Tx
UC --> VM : seguinte
VM --> Tela : nova competência com os previstos
Tela --> U : mostra o mês seguinte
@enduml
