@startuml casos-de-uso
title Controle de Gastos — Diagrama de Casos de Uso
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam rectangle {
  BorderColor #444444
}

actor "Usuário titular" as U

rectangle "Controle de Gastos" {
  usecase "UC01\nRegistrar gasto" as UC01 #E7F1FB
  usecase "UC02\nRegistrar compra\nparcelada" as UC02 #E7F1FB
  usecase "UC03\nFechar o mês e\nabrir o seguinte" as UC03 #E7F1FB
  usecase "UC04\nConsultar resumo\ndo período" as UC04
  usecase "UC05\nConsultar fatura\ndo cartão" as UC05
  usecase "UC06\nGerenciar meios\nde pagamento" as UC06
  usecase "UC07\nGerenciar contas\nfixas e salário" as UC07
  usecase "UC08\nRegistrar receita\navulsa" as UC08
  usecase "UC09\nCorrigir\nlançamento" as UC09
  usecase "UC10\nGerenciar\ninvestimentos" as UC10
  usecase "UC11\nRegistrar reembolso\nde terceiro" as UC11

  usecase "Gerar lançamentos\nrecorrentes previstos" as GLR
}

U --> UC03
U --> UC01
U --> UC02
U --> UC04
U --> UC05
U --> UC06
U --> UC07
U --> UC08
U --> UC09
U --> UC10
U --> UC11

UC03 ..> GLR : <<include>>
UC02 .[norank].> UC01 : <<extend>>

note as N2
  UC02 estende UC01 no ponto
  "pagamento parcelado no crédito"
end note

note as N1
  Titular de cartão (ex.: cônjuge) e
  terceiro reembolsante (ex.: pai)
  são partes interessadas: não operam
  o sistema nesta versão.
end note

legend bottom right
  Azul = casos de uso centrais, com
  especificação completa (UC01 a UC03);
  UC02 e UC03 têm diagrama de sequência
endlegend
@enduml
