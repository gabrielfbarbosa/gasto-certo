@startuml modelo-dominio
title Controle de Gastos — Modelo de Domínio
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
hide methods
hide circle
hide empty members

' ---------- Cadastros ----------
class Pessoa {
  nome
  papel : USUARIO | TITULAR | TERCEIRO
}
class Instituicao {
  nome
}
abstract class MeioDePagamento {
  nome
  ativo : Boolean
}
class CartaoDeCredito {
  diaFechamento : 1..31
  diaVencimento : 1..31
}
class "ContaCorrente\n<size:10>(débito/Pix)</size>" as ContaCorrente
class CarteiraMoedaEstrangeira {
  moeda
}
class "ContaInvestimento\n<size:10>(corretora)</size>" as ContaInvestimento {
  aportePlanejadoMensal : Dinheiro [0..1]
}

' ---------- Recorrências ----------
class ContaFixa #F7F7F5 {
  descricao
  valorPrevisto : Dinheiro
  diaVencimento : 1..31
}
class ReceitaRecorrente #F7F7F5 {
  descricao
  valor : Dinheiro
  diaRecebimento : 1..31
}

' ---------- Movimentação ----------
class Competencia #EEF4FB {
  mesAno
  situacao : ABERTA | FECHADA
  /receitas : Dinheiro
  /gastoTotal : Dinheiro
  /gastosDeTerceiros : Dinheiro
  /sobra : Dinheiro
}
class Fatura #EEF4FB {
  dataFechamento
  dataVencimento
  /total : Dinheiro
}
abstract class Lancamento #EEF4FB {
  valor : Dinheiro
  data
  descricao
  situacao : PREVISTO | REALIZADO
}
class Gasto #EEF4FB
class Receita #EEF4FB {
  tipo : SALARIO | AVULSA | VENDA_INVESTIMENTO
}
class CompraParcelada #EEF4FB {
  valorTotal : Dinheiro
  quantidadeParcelas : 2..48
}
class Parcela #EEF4FB {
  numero : k/N
}
class Reembolso #EEF4FB {
  valor : Dinheiro
  data
}
class ConversaoCambial #EEF4FB {
  valorOriginal
  cotacao
}

' layout: cadastros no topo
Instituicao "1" -right- "0..*" MeioDePagamento : emite >
Pessoa "1" -down- "0..*" MeioDePagamento : titular de >
MeioDePagamento <|-down- CartaoDeCredito
MeioDePagamento <|-down- ContaCorrente
MeioDePagamento <|-down- CarteiraMoedaEstrangeira
MeioDePagamento <|-down- ContaInvestimento

CartaoDeCredito "1" -down- "0..*" Fatura : gera >
Fatura "0..*" -right- "1" Competencia : vence em >

Lancamento <|-down- Gasto
Lancamento <|-down- Receita
Gasto <|-down- Parcela
Lancamento "0..*" -up- "1" Competencia : pertence a >

Gasto "0..*" -up- "1" MeioDePagamento : pago com >
Gasto "0..*" -up- "0..1" Fatura : compõe >
Gasto "0..*" -left- "0..1" Pessoa : em nome de\n(terceiro) >
Gasto "1" -down- "0..1" ConversaoCambial : convertido por >
Pessoa "1" -down- "0..*" Reembolso : devolve >
CompraParcelada "1" *-right- "2..48" Parcela : dividida em >

ContaFixa "0..*" -up- "1" MeioDePagamento : debitada em >
ContaFixa "1" -down- "0..*" Gasto : origina >
ReceitaRecorrente "1" -down- "0..*" Receita : origina >
ContaInvestimento "0..1" -down- "0..*" Receita : venda de ativo >

note right of Competencia
  sobra = receitas − (gastoTotal − gastosDeTerceiros)  [RN04]
  Reembolso só dá baixa no "a receber"; não é receita  [RN03]
  FECHADA não aceita inclusão, edição ou exclusão  [RN08]
end note
note bottom of Fatura
  Até o fechamento: fatura do ciclo; depois: a seguinte.
  Competência da fatura = mês do vencimento  [RN01]
end note
@enduml
