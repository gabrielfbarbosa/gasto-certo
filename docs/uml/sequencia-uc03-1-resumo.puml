@startuml sequencia-uc03-1-resumo
!include estilo.iuml
hide footbox
hide <<foco>> stereotype
autonumber "<b>0"
title UC03 – Fechar o mês · Parte 1/3: resumo antes de fechar

actor "Usuário" as U
boundary "FecharMesScreen" as Tela
participant "FecharMesViewModel" as VM <<viewmodel>>
participant "ConsultarResumoUseCase" as CR
participant "LancamentoRepository" as LRepo <<repositório>>
participant "ResumoDoPeriodo" as Res

U -> Tela : abre "Fechar mês"
Tela -> VM : carregar(mes)
activate VM
VM -> CR : doMes(mes, titular = null)
activate CR
CR -> LRepo : doMes(mes)
LRepo --> CR : lancamentos
CR -> Res : de(lancamentos, null)
Res --> CR : resumo
CR --> VM : resumo: receitas, gasto total,\nterceiros, sobra [RN04]
deactivate CR
VM --> Tela : estado com o resumo e os\nprevistos não conferidos
deactivate VM
Tela --> U : mostra o resumo
opt há previstos não conferidos (A1)
  U -> Tela : ajusta valores (UC09) ou segue
end
@enduml
