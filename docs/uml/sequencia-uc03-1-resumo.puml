@startuml sequencia-uc03-1-resumo
!include estilo.iuml
hide footbox
hide <<foco>> stereotype
autonumber "<b>0"
title UC03 – Fechar o mês · Parte 1/3: resumo antes de fechar

actor "Usuário" as U
boundary "CloseMonthScreen" as Tela
participant "CloseMonthViewModel" as VM <<viewmodel>>
participant "GetSummaryUseCase" as CR
participant "EntryRepository" as LRepo <<repositório>>
participant "PeriodSummary" as Res

U -> Tela : abre "Fechar mês"
Tela -> VM : load(month)
activate VM
VM -> CR : ofMonth(month, holder = null)
activate CR
CR -> LRepo : ofMonth(month)
LRepo --> CR : entries
CR -> Res : of(entries, null)
Res --> CR : summary
CR --> VM : summary: income, totalExpenses,\nthirdPartyExpenses, surplus() [RN04]
deactivate CR
VM --> Tela : uiState com o resumo e os\nprevistos não conferidos
deactivate VM
Tela --> U : mostra o resumo
opt há previstos não conferidos (A1)
  U -> Tela : ajusta valores (UC09) ou segue
end
@enduml
