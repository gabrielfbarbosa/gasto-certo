@startuml modelo-dominio-1-cadastros
!include estilo.iuml
title GastoCerto — Modelo de Domínio (1/2): cadastros e recorrências
hide methods
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype

class Person {
  name
  role : USER | HOLDER | THIRD_PARTY
}
class Institution {
  name
}
abstract class PaymentMethod {
  name
  active : Boolean
}
class CreditCard {
  closingDay : 1..31
  dueDay : 1..31
}
class CheckingAccount <<débito / Pix>>
class ForeignCurrencyWallet {
  currency
}
class InvestmentAccount <<corretora>> {
  plannedMonthlyContribution : Money [0..1]
}
class RecurringBill {
  description
  expectedAmount : Money
  dueDay : 1..31
}
class RecurringIncome {
  description
  amount : Money
  payDay : 1..31
}

Institution "1" -- "0..*" PaymentMethod : emite >
Person "1" -- "0..*" PaymentMethod : titular de >
PaymentMethod <|-- CreditCard
PaymentMethod <|-- CheckingAccount
PaymentMethod <|-- ForeignCurrencyWallet
PaymentMethod <|-- InvestmentAccount
RecurringBill "0..*" -up- "1" PaymentMethod : debitada em >

note right of Person
  Todo meio tem um titular; uma instituição
  pode ter cartões de titulares diferentes [RN10]
end note
note bottom of RecurringBill
  Gera um gasto EXPECTED por mês
  no dia de vencimento [RN06]
end note
note bottom of RecurringIncome
  Salário: receita EXPECTED no
  dia de recebimento [RN07]
end note
note bottom of CreditCard
  Meio com lançamentos não é excluído,
  só desativado [RN09]
end note
@enduml
