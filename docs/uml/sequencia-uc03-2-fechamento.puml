@startuml sequencia-uc03-2-fechamento
!include estilo.iuml
hide footbox
hide <<foco>> stereotype
autonumber "<b>0"
title UC03 – Fechar o mês · Parte 2/3: fechamento numa única transação

actor "Usuário" as U
boundary "CloseMonthScreen" as Tela
participant "CloseMonthViewModel" as VM <<viewmodel>>
participant "CloseMonthUseCase" as UC <<foco>>
participant "Transaction" as Tx <<repositório>>
participant "AccountingMonth\nRepository" as CRepo <<repositório>>
participant "current :\nAccountingMonth" as Atual
participant "Recurrence\nRepository" as RRepo <<repositório>>
participant "EntryFactory" as Fab
participant "Entry\nRepository" as LRepo <<repositório>>

U -> Tela : confirma o fechamento
Tela -> VM : close()
activate VM
VM -> UC : execute(month)
activate UC
UC -> Tx : execute { … }
activate Tx
UC -> CRepo : findOrCreate(month)
CRepo --> UC : current
UC -> Atual : close()
alt já estava fechada (E1)
  Atual --> UC : <<lança>> AccountingMonthClosed [RN08]
  UC --> VM : AccountingMonthClosed
  VM --> Tela : evento "Mês já fechado. Reabrir?"
else aberta
  UC -> CRepo : save(current)
  UC -> CRepo : findOrCreate(month.next())
  CRepo --> UC : following
  UC -> RRepo : activeRecurringBills(), activeRecurringIncomes(),\ninvestmentsWithContribution()
  RRepo --> UC : bills, incomes, investments
  UC -> Fab : expectedForMonth(following.monthYear,\nbills, incomes, investments)
  ref over Fab : Parte 3:\ngerar previstos
  Fab --> UC : expected
  UC -> LRepo : ofMonth(following.monthYear)
  LRepo --> UC : existing
  UC -> UC : withoutDuplicates(expected, existing)\n(A3 · mesmo originId)
  UC -> LRepo : saveAll(newEntries)
end
Tx --> UC : confirma tudo ou desfaz tudo
deactivate Tx
UC --> VM : following
deactivate UC
VM --> Tela : uiState com a nova competência
deactivate VM
Tela --> U : mostra o mês seguinte
@enduml
