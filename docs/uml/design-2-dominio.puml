@startuml design-2-dominio
title Controle de Gastos — Design (vista 2): modelo do domínio (domain.model)
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
hide circle
hide empty members

class Dinheiro <<value>> {
  - centavos : Long
  + plus(outro) : Dinheiro
  + minus(outro) : Dinheiro
  + dividirEm(n : Int) : List<Dinheiro>
  + converter(cotacao : BigDecimal) : Dinheiro
  + ehPositivo() : Boolean
}
class MesAno <<value>> {
  + ano : Int
  + mes : Int
  + proximo() : MesAno
  + dia(dia : Int) : LocalDate
}
class Competencia {
  + mesAno : MesAno
  - situacao : ABERTA | FECHADA
  + fechar()
  + reabrir()
  + garantirAberta()
}
class ResumoDoPeriodo <<value>> {
  + receitas : Dinheiro
  + gastoTotal : Dinheiro
  + gastosDeTerceiros : Dinheiro
  + porMeio : Map<MeioDePagamento, Dinheiro>
  + porTitular : Map<Pessoa, Dinheiro>
  + sobra() : Dinheiro
  + {static} de(lancamentos, titular : Pessoa?) : ResumoDoPeriodo
}
class SaldoAReceber <<value>> {
  + terceiro : Pessoa
  + valor : Dinheiro
  + {static} de(gastos, reembolsos) : SaldoAReceber
  + validarReembolso(valor : Dinheiro)
}
abstract class MeioDePagamento {
  + nome : String
  + titular : Pessoa
  + instituicao : Instituicao
  + ativo : Boolean
  + {abstract} politicaDeCompetencia() : PoliticaDeCompetencia
}
class CartaoDeCredito {
  + diaFechamento : Int
  + diaVencimento : Int
}
class ContaCorrente
class CarteiraMoedaEstrangeira {
  + moeda : String
}
class ContaInvestimento {
  + aportePlanejadoMensal : Dinheiro?
  + gerarAportePrevisto(mes : MesAno) : Gasto?
}
abstract class Lancamento {
  + valor : Dinheiro
  + data : LocalDate
  + descricao : String
  + competencia : MesAno
  - situacao : PREVISTO | REALIZADO
  + confirmar(valorReal : Dinheiro)
}
class Gasto {
  + meio : MeioDePagamento
  + terceiro : Pessoa?
  + ehDeTerceiro() : Boolean
}
class Parcela {
  + numero : Int
  + totalDeParcelas : Int
  + rotulo() : String
}
class Receita {
  + tipo : SALARIO | AVULSA | VENDA_INVESTIMENTO
}
class CompraParcelada {
  + valorTotal : Dinheiro
  + quantidade : Int
  + dataCompra : LocalDate
  + cartao : CartaoDeCredito
  + terceiro : Pessoa?
  + gerarParcelas() : List<Parcela>
}
class ConversaoCambial {
  + valorOriginal : BigDecimal
  + cotacao : BigDecimal
  + emReais() : Dinheiro
}
class ContaFixa {
  + valorPrevisto : Dinheiro
  + diaVencimento : Int
  + meio : MeioDePagamento
  + gerarPrevisto(mes : MesAno) : Gasto
}
class ReceitaRecorrente {
  + valor : Dinheiro
  + diaRecebimento : Int
  + gerarPrevista(mes : MesAno) : Receita
}
class Reembolso {
  + terceiro : Pessoa
  + valor : Dinheiro
  + data : LocalDate
}
class Fatura <<value>> {
  + cartao : CartaoDeCredito
  + competencia : MesAno
  + dataFechamento : LocalDate
  + dataVencimento : LocalDate
  + gastos : List<Gasto>
  + total() : Dinheiro
  + {static} de(cartao, mes, gastos) : Fatura
}
class Pessoa {
  + nome : String
  + papel : USUARIO | TITULAR | TERCEIRO
}
class Instituicao {
  + nome : String
}

MeioDePagamento <|-- CartaoDeCredito
MeioDePagamento <|-- ContaCorrente
MeioDePagamento <|-- CarteiraMoedaEstrangeira
MeioDePagamento <|-- ContaInvestimento
MeioDePagamento "0..*" -up-> "1" Pessoa : titular
MeioDePagamento "0..*" -up-> "1" Instituicao

Lancamento <|-- Gasto
Lancamento <|-- Receita
Gasto <|-- Parcela
Gasto "0..*" -up-> "1" MeioDePagamento : meio
Gasto "0..*" --> "0..1" Pessoa : terceiro
Gasto "1" *-- "0..1" ConversaoCambial
CompraParcelada "1" *-- "2..48" Parcela : cria >
CompraParcelada --> "1" CartaoDeCredito

Fatura --> "1" CartaoDeCredito
Fatura o-- "0..*" Gasto
ContaFixa ..> Gasto : cria
ReceitaRecorrente ..> Receita : cria
ContaInvestimento ..> Gasto : cria
Reembolso --> "1" Pessoa
ResumoDoPeriodo ..> Lancamento : soma
SaldoAReceber ..> Gasto
SaldoAReceber ..> Reembolso
Competencia --> MesAno
Lancamento ..> Dinheiro

note as N1
  <b>Information Expert</b>: quem tem os dados faz o cálculo —
  CompraParcelada gera as parcelas, Competencia se fecha,
  ResumoDoPeriodo calcula a sobra  [RN02, RN04, RN08]
  <b>Creator</b>: CompraParcelada cria Parcela; ContaFixa,
  ReceitaRecorrente e ContaInvestimento criam seus previstos
end note
note as N3
  Fatura não é gravada: é montada a partir
  do cartão + competência (mês do vencimento)
  com os gastos daquele mês  [RN01, RF13]
end note
N3 .. Fatura
note as N2
  Dinheiro guarda centavos em Long: sem erro de
  ponto flutuante  [RNF04]. dividirEm põe o resto
  da divisão na 1ª parcela  [RN02]
end note
N2 .. Dinheiro
@enduml
