@startuml design-3-regras
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
title GastoCerto — Design (vista 3): regras, Strategy e Factory (domain.regra)

package "Strategy — competência do gasto [RN01]" {
  interface PoliticaDeCompetencia <<Strategy>> {
    + competenciaDe(data : LocalDate) : MesAno
  }
  class CompetenciaPorFechamentoDeFatura {
    - diaFechamento : Int
    - diaVencimento : Int
    + competenciaDe(data) : MesAno
  }
  class CompetenciaPorDataDoGasto {
    + competenciaDe(data) : MesAno
  }
}
package "Factory — criação de lançamentos" {
  class FabricaDeLancamentos <<Factory>> {
    + gasto(dados : DadosDoGasto) : Gasto
    + compraParcelada(dados : DadosDaCompra) : CompraParcelada
    + previstosDoMes(mes, contasFixas, receitas, investimentos) : List<Lancamento>
  }
  class DadosDoGasto <<value>> {
    meio, valor, data, descricao,
    terceiro?, valorEmMoeda?, cotacao?
  }
  class DadosDaCompra <<value>> {
    cartao, valorTotal, quantidade,
    dataCompra, descricao, terceiro?
  }
}
package "Exceções de regra" {
  abstract class RegraVioladaException {
    + regra : String
    + mensagem : String
  }
  class ValorInvalido <<RN09>>
  class CotacaoInvalida <<RN05>>
  class ParcelasForaDoLimite <<RN02>>
  class CompetenciaFechada <<RN08>>
  class ReembolsoMaiorQueSaldo <<RN03>>
  class MeioComLancamentos <<RN09>>
  class DiaInvalido <<RN09>>
  class TitularInvalido <<RN10>>
}
class "CartaoDeCredito" as Cartao <<ref>>
class "ContaCorrente · CarteiraMoedaEstrangeira\n· ContaInvestimento" as Outros <<ref>>

PoliticaDeCompetencia <|.. CompetenciaPorFechamentoDeFatura
PoliticaDeCompetencia <|.. CompetenciaPorDataDoGasto
Cartao ..> CompetenciaPorFechamentoDeFatura : cria
Outros ..> CompetenciaPorDataDoGasto : cria
FabricaDeLancamentos ..> DadosDoGasto
FabricaDeLancamentos ..> DadosDaCompra
FabricaDeLancamentos ..> PoliticaDeCompetencia : usa
FabricaDeLancamentos ..> RegraVioladaException : lança
RegraVioladaException <|-- ValorInvalido
RegraVioladaException <|-- CotacaoInvalida
RegraVioladaException <|-- ParcelasForaDoLimite
RegraVioladaException <|-- CompetenciaFechada
RegraVioladaException <|-- ReembolsoMaiorQueSaldo
RegraVioladaException <|-- MeioComLancamentos
RegraVioladaException <|-- DiaInvalido
RegraVioladaException <|-- TitularInvalido

note bottom of CompetenciaPorFechamentoDeFatura
  Cartão: até o fechamento entra no ciclo atual;
  competência = mês do vencimento.
  Novo tipo de meio = nova política,
  sem mexer nos casos de uso.
end note
note right of FabricaDeLancamentos
  Centraliza as variações de criação (simples, moeda
  estrangeira, terceiro, parcelado, previstos do mês)
  e as validações comuns [RN02, RN05, RN06, RN07, RN09, RN11]
end note
@enduml
