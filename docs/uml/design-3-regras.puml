@startuml design-3-regras
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
title GastoCerto — Design (vista 3): regras, Strategy e Factory (domain.rule)

package "Strategy — competência do gasto [RN01]" {
  interface AccountingMonthPolicy <<Strategy>> {
    + accountingMonthOf(date : LocalDate) : MonthYear
  }
  class StatementClosingPolicy {
    - closingDay : Int
    - dueDay : Int
    + accountingMonthOf(date) : MonthYear
  }
  class ExpenseDatePolicy {
    + accountingMonthOf(date) : MonthYear
  }
}
package "Factory — criação de lançamentos" {
  class EntryFactory <<Factory>> {
    + expense(input : ExpenseInput) : Expense
    + installmentPurchase(input : PurchaseInput) : InstallmentPurchase
    + income(amount, date, description, type) : Income
    + expectedForMonth(month, recurringBills, recurringIncomes, investments) : List<Entry>
  }
  class ExpenseInput <<value>> {
    paymentMethod, amount, date, description,
    thirdParty?, foreignAmount?, exchangeRate?
  }
  class PurchaseInput <<value>> {
    card, totalAmount, installmentCount,
    purchaseDate, description, thirdParty?
  }
}
package "Exceções de regra" {
  abstract class RuleViolationException {
    + rule : String
    + message : String
  }
  class InvalidAmount <<RN09>> {
    + amount : Money
  }
  class InvalidExchangeRate <<RN05>> {
    + exchangeRate : Long
  }
  class InstallmentsOutOfRange <<RN02>> {
    + installmentCount : Int
  }
  class AccountingMonthClosed <<RN08>> {
    + month : MonthYear
  }
  class ReimbursementExceedsBalance <<RN03>> {
    + amount : Money
    + balance : Money
  }
  class PaymentMethodHasEntries <<RN09>> {
    + name : String
  }
  class InvalidDay <<RN09>> {
    + kind : CLOSING | DUE | PAY
    + day : Int
  }
  class InvalidHolder <<RN10>> {
    + name : String
  }
}
class "CreditCard" as Cartao <<ref>>
class "CheckingAccount · ForeignCurrencyWallet\n· InvestmentAccount" as Outros <<ref>>

AccountingMonthPolicy <|.. StatementClosingPolicy
AccountingMonthPolicy <|.. ExpenseDatePolicy
Cartao ..> StatementClosingPolicy : cria
Outros ..> ExpenseDatePolicy : cria
EntryFactory ..> ExpenseInput
EntryFactory ..> PurchaseInput
EntryFactory ..> AccountingMonthPolicy : usa
EntryFactory ..> RuleViolationException : lança
RuleViolationException <|-- InvalidAmount
RuleViolationException <|-- InvalidExchangeRate
RuleViolationException <|-- InstallmentsOutOfRange
RuleViolationException <|-- AccountingMonthClosed
RuleViolationException <|-- ReimbursementExceedsBalance
RuleViolationException <|-- PaymentMethodHasEntries
RuleViolationException <|-- InvalidDay
RuleViolationException <|-- InvalidHolder

note bottom of StatementClosingPolicy
  Cartão: até o fechamento entra no ciclo atual;
  competência = mês do vencimento.
  Novo tipo de meio = nova política,
  sem mexer nos casos de uso.
end note
note right of EntryFactory
  Centraliza as variações de criação (simples, moeda
  estrangeira, terceiro, parcelado, receita, previstos do mês)
  e as validações comuns [RN02, RN05, RN06, RN07, RN09, RN11]
end note
@enduml
