@startuml design-2b-dominio-cadastros
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
title GastoCerto — Design (vista 2b): cadastros e recorrências (domain.model)

class Person {
  + id : String
  + name : String
  + role : USER | HOLDER | THIRD_PARTY
}
class Institution {
  + id : String
  + name : String
}
abstract class PaymentMethod <<foco>> {
  + id : String
  + name : String
  + holder : Person
  + institution : Institution
  + active : Boolean
  + {abstract} accountingMonthPolicy() : AccountingMonthPolicy
}
class CreditCard {
  + closingDay : Int
  + dueDay : Int
}
class CheckingAccount
class ForeignCurrencyWallet {
  + currency : String
}
class InvestmentAccount {
  + plannedMonthlyContribution : Money?
  + generateExpectedContribution(month : MonthYear) : Expense?
}
class RecurringBill {
  + id : String
  + description : String
  + expectedAmount : Money
  + dueDay : Int
  + paymentMethod : PaymentMethod
  + active : Boolean
  + generateExpected(month : MonthYear) : Expense
}
class RecurringIncome {
  + id : String
  + description : String
  + amount : Money
  + payDay : Int
  + active : Boolean
  + generateExpected(month : MonthYear) : Income
}
class Expense <<ref>>
class Income <<ref>>
interface AccountingMonthPolicy <<ref>>

PaymentMethod "0..*" -up-> "1" Person : holder
PaymentMethod "0..*" -up-> "1" Institution
PaymentMethod <|-- CreditCard
PaymentMethod <|-- CheckingAccount
PaymentMethod <|-- ForeignCurrencyWallet
PaymentMethod <|-- InvestmentAccount
PaymentMethod .right.> AccountingMonthPolicy
RecurringBill --> "1" PaymentMethod : paymentMethod
RecurringBill ..> Expense : cria
RecurringIncome ..> Income : cria
InvestmentAccount ..> Expense : cria

note bottom of RecurringBill
  <b>Creator</b>: gera o gasto EXPECTED do mês,
  com originId = id da conta [RN06 · D3]
end note
note bottom of RecurringIncome
  <b>Creator</b>: salário EXPECTED no dia
  de recebimento [RN07 · D3]
end note
note bottom of CreditCard
  dias entre 1 e 31 [RN09]
end note
legend left
  id : String = UUID gerado no domínio; igualdade por id [D2].
  Cinza = detalhada em outra vista. Dia inexistente no mês → último dia.
endlegend
@enduml
