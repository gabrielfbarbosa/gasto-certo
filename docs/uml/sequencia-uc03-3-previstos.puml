@startuml sequencia-uc03-3-previstos
!include estilo.iuml
hide footbox
hide <<foco>> stereotype
autonumber "<b>0"
title UC03 – Fechar o mês · Parte 3/3: gerar os previstos do mês seguinte

participant "CloseMonthUseCase" as UC <<foco>>
participant "EntryFactory" as Fab
participant "RecurringBill" as CF
participant "RecurringIncome" as RR
participant "InvestmentAccount" as CI

UC -> Fab : expectedForMonth(month, bills,\nincomes, investments)
activate Fab
loop cada conta fixa ativa
  Fab -> CF : generateExpected(month)
  CF --> Fab : gasto EXPECTED no vencimento\n(dia inexistente = último dia) [RN06]
end
loop cada receita recorrente
  Fab -> RR : generateExpected(month)
  RR --> Fab : receita EXPECTED no recebimento [RN07]
end
loop cada corretora com aporte planejado
  Fab -> CI : generateExpectedContribution(month)
  CI --> Fab : aporte EXPECTED [RN11]
end
Fab --> UC : expected (cada um com originId)
deactivate Fab
@enduml
