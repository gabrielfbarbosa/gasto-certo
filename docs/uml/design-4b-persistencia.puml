@startuml design-4b-persistencia
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
set separator none
title GastoCerto — Design (vista 4b): repositórios, persistência e injeção (domain.repository · data · di)

package "domain.repository" {
  interface EntryRepository {
    + save(entry : Entry)
    + saveAll(entries : List<Entry>)
    + delete(entry : Entry)
    + findById(id : String) : Entry?
    + ofMonth(month : MonthYear) : List<Entry>
    + ofPeriod(start : LocalDate, end : LocalDate) : List<Entry>
    + ofThirdParty(thirdParty : Person) : List<Expense>
  }
  interface AccountingMonthRepository {
    + findOrCreate(month : MonthYear) : AccountingMonth
    + save(accountingMonth : AccountingMonth)
  }
  interface RegistryRepository {
    + people() : List<Person>
    + institutions() : List<Institution>
    + activePaymentMethods() : List<PaymentMethod>
    + savePerson(person : Person)
    + saveInstitution(institution : Institution)
    + savePaymentMethod(paymentMethod : PaymentMethod)
    + deletePaymentMethod(paymentMethod : PaymentMethod)
    + hasEntries(paymentMethod : PaymentMethod) : Boolean
  }
  interface RecurrenceRepository {
    + activeRecurringBills() : List<RecurringBill>
    + activeRecurringIncomes() : List<RecurringIncome>
    + investmentsWithContribution() : List<InvestmentAccount>
    + saveRecurringBill(bill : RecurringBill)
    + saveRecurringIncome(income : RecurringIncome)
  }
  interface ReimbursementRepository {
    + save(reimbursement : Reimbursement)
    + ofThirdParty(thirdParty : Person) : List<Reimbursement>
  }
  interface Transaction <<foco>> {
    + execute(block : suspend () -> T) : T
  }
}
package "data (Room KMP · mobileMain)" {
  class AppDatabase <<RoomDatabase>>
  class "Room*Repository (5)" as RoomRepos
  class RoomTransaction
  class "DAOs + Entities + Mappers" as Daos
}
package "data.memory (commonMain)" {
  class "InMemory*Repository (5)" as MemRepos
  class InMemoryTransaction
  class InMemoryDatabase
}
package "di (Koin)" {
  class appModule
  class "platformModule (expect/actual)" as platformModule
  class "roomDataModule()" as roomModule
  class inMemoryDataModule
}
class "*UseCase" as UseCases <<ref>>

UseCases .down.> EntryRepository : usa
UseCases .down.> Transaction : usa
appModule .down.> UseCases : factory
platformModule .down.> roomModule : Android/iOS
platformModule .down.> inMemoryDataModule : Web
roomModule .down.> RoomRepos : single
inMemoryDataModule .down.> MemRepos : single
RoomRepos .up.|> EntryRepository : implementa (as 5)
RoomTransaction .up.|> Transaction
MemRepos .up.|> EntryRepository : implementa (as 5)
InMemoryTransaction .up.|> Transaction
MemRepos --> InMemoryDatabase
InMemoryTransaction --> InMemoryDatabase : foto e restaura
RoomRepos --> Daos
RoomTransaction --> AppDatabase
AppDatabase --> Daos
EntryRepository -[hidden]down- MemRepos
AccountingMonthRepository -[hidden]down- RoomRepos
RegistryRepository -[hidden]right- RecurrenceRepository

legend right
  Todos os métodos são suspend; Flow só onde a tela observa [D4].
  RoomTransaction usa useWriterConnection { immediateTransaction { } }:
  tudo ou nada no fechamento do mês (UC03).
  Room: 8 tabelas com chaves estrangeiras (pessoa, instituição e meio
  são salvos antes do que aponta para eles); enums gravados pelo nome.
  <b>Low Coupling + Dependency Injection</b>: os use cases conhecem só
  as interfaces; o Koin injeta Room no mobile e memória na Web/testes.
  Room*Repository e InMemory*Repository: uma classe por interface,
  com o mesmo nome (ex.: RoomEntryRepository); setas resumidas.
endlegend
@enduml
