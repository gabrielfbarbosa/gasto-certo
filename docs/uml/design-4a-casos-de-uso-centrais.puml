@startuml design-4a-casos-de-uso-centrais
!include estilo.iuml
hide circle
hide empty members
hide <<ref>> members
hide <<ref>> stereotype
hide <<foco>> stereotype
title GastoCerto — Design (vista 4a): interface e casos de uso centrais (ui → usecase)
left to right direction

package "ui" {
  class RegisterExpenseScreen <<Composable>>
  class CloseMonthScreen <<Composable>>
  class SummaryScreen <<Composable>>
  class RegisterExpenseViewModel {
    + uiState : StateFlow<RegisterExpenseUiState>
    + events : Flow<RegisterExpenseEvent>
    + previewInstallments()
    + confirm()
    + reopenAndConfirm(month : MonthYear)
  }
  class CloseMonthViewModel {
    + uiState : StateFlow<CloseMonthUiState>
    + events : Flow<CloseMonthEvent>
    + load(month : MonthYear)
    + close()
    + reopen()
  }
  class SummaryViewModel {
    + uiState : StateFlow<SummaryUiState>
    + selectPeriod(period : Period)
    + filterHolder(holder : Person?)
  }
}
package "usecase" {
  class RegisterExpenseUseCase <<Controller>> {
    + execute(input : ExpenseInput) : Expense
  }
  class RegisterInstallmentPurchaseUseCase <<Controller>> {
    + preview(input : PurchaseInput) : List<Installment>
    + execute(input : PurchaseInput) : InstallmentPurchase
  }
  class CloseMonthUseCase <<foco>> {
    + execute(month : MonthYear) : AccountingMonth
    - withoutDuplicates(expected, existing) : List<Entry>
  }
  class ReopenMonthUseCase <<Controller>> {
    + execute(month : MonthYear) : AccountingMonth
  }
  class GetSummaryUseCase <<Controller>> {
    + ofMonth(month : MonthYear, holder : Person?) : PeriodSummary
    + ofWeek(date : LocalDate) : PeriodSummary
    + ofYear(year : Int) : PeriodSummary
  }
  class GetStatementUseCase <<Controller>> {
    + execute(card : CreditCard, month : MonthYear) : Statement
  }
}

RegisterExpenseScreen --> RegisterExpenseViewModel
CloseMonthScreen --> CloseMonthViewModel
SummaryScreen --> SummaryViewModel
RegisterExpenseViewModel --> RegisterExpenseUseCase
RegisterExpenseViewModel --> RegisterInstallmentPurchaseUseCase
RegisterExpenseViewModel --> ReopenMonthUseCase
CloseMonthViewModel --> GetSummaryUseCase
CloseMonthViewModel --> CloseMonthUseCase
CloseMonthViewModel --> ReopenMonthUseCase
SummaryViewModel --> GetSummaryUseCase
SummaryViewModel --> GetStatementUseCase

legend right
  <b>MVVM + fluxo unidirecional</b>: a tela desenha só o XUiState
  (UiState imutável) e reage a XEvent (efeito único: snackbar,
  navegar, oferecer reabrir). Ações = métodos do ViewModel.
  <b>Controller (GRASP)</b>: cada *UseCase coordena um caso de uso
  e delega as regras ao domínio. CloseMonthUseCase em destaque.
  Métodos dos use cases são suspend [D4]. O RegisterExpenseViewModel
  lista meios e terceiros pelo ManageRegistryUseCase (vista 5) e, se o
  mês estiver fechado [RN08], oferece reabrir (reopenAndConfirm).
endlegend
@enduml
